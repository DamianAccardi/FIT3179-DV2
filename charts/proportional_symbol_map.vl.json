
{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  
    "title": {
      "text": "Where Are NSW's Most Visited National Parks?",
      "subtitle": "Circle area shows estimated domestic visits, 2024–25 (selected parks)",
      "anchor": "middle",
      "fontSize": 19,
      "subtitleFontSize": 12,
      "subtitleColor": "#555555"
    },
  
    "width": 690,
    "height": 530,
    "background": "white",
  
    "projection": {
      "type": "mercator",
      "center": [147.5, -33],
      "scale": 2250
    },
  
    "layer": [
      {
        "description": "NSW state background",
  
        "data": {
          "url": "data/nsw_state_outline.geojson",
          "format": {
            "type": "json",
            "property": "features"
          }
        },
  
        "mark": {
          "type": "geoshape",
          "fill": "#eef0eb",
          "stroke": "#6c7d73",
          "strokeWidth": 1.2
        }
      },
  
      {
        "description": "Proportional circles for park visits",
  
        "data": {
          "url": "data/nsw_park_symbol_data.csv",
          "format": {
            "type": "csv",
            "parse": {
              "longitude": "number",
              "latitude": "number",
              "visits": "number"
            }
          }
        },
  
        "mark": {
          "type": "circle",
          "filled": true,
          "color": "#087744",
          "opacity": 0.65,
          "stroke": "#ffffff",
          "strokeWidth": 1
        },
  
        "encoding": {
          "longitude": {
            "field": "longitude",
            "type": "quantitative"
          },
  
          "latitude": {
            "field": "latitude",
            "type": "quantitative"
          },
  
          "size": {
            "field": "visits",
            "type": "quantitative",
            "title": "Domestic visits",
  
            "scale": {
              "type": "linear",
              "domain": [0, 8000000],
              "range": [0, 3200]
            },
  
            "legend": {
              "orient": "right",
              "values": [
                1000000,
                3000000,
                5000000,
                8000000
              ],
              "format": ".2s",
              "titleFontSize": 12,
              "labelFontSize": 11
            }
          },
  
          "tooltip": [
            {
              "field": "park",
              "type": "nominal",
              "title": "National park"
            },
            {
              "field": "visits",
              "type": "quantitative",
              "title": "Domestic visits",
              "format": ",.0f"
            }
          ]
        }
      }
    ],
  
    "config": {
      "view": {
        "stroke": null
      }
    }
  }
  