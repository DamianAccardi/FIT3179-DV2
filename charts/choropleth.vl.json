
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Total area of non-overlapping national parks by Australian state and territory, CAPAD 2024.",
  "background": "white",
  "width": 760,
  "height": 480,

  "title": {
    "text": "Which States Have the Most Land Protected as National Parks?",
    "subtitle": "Total national park area in hectares — CAPAD 2024",
    "anchor": "middle",
    "fontSize": 19,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555",
    "offset": 20
  },

  "data": {
    "url": "data/australian_states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "calculate": "datum.properties.STATE_NAME",
      "as": "state_name"
    },
    {
      "lookup": "state_name",
      "from": {
        "data": {
          "url": "data/national_park_area_by_state.csv",
          "format": {
            "type": "csv",
            "parse": {
              "area_ha": "number",
              "area_km2": "number"
            }
          }
        },
        "key": "state",
        "fields": [
          "area_ha",
          "area_km2"
        ]
      }
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.5
  },

  "encoding": {
    "color": {
      "field": "area_ha",
      "type": "quantitative",
      "title": "National park area (ha)",
      "scale": {
        "scheme": "greens"
      },
      "legend": {
        "orient": "right",
        "gradientLength": 230,
        "gradientThickness": 18,
        "format": "~s",
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },

    "tooltip": [
      {
        "field": "state_name",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "area_ha",
        "type": "quantitative",
        "title": "National park area (ha)",
        "format": ",.2f"
      },
      {
        "field": "area_km2",
        "type": "quantitative",
        "title": "National park area (km²)",
        "format": ",.2f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Outfit, sans-serif",
      "titleFont": "Outfit, sans-serif"
    }
  }
}
