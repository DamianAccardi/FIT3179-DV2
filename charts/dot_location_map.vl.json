
{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  
    "title": {
      "text": "Where Are Australia's National Parks?",
      "subtitle": "Locations of national parks recorded in CAPAD 2024",
      "anchor": "middle",
      "fontSize": 20,
      "subtitleFontSize": 13,
      "subtitleColor": "#555"
    },
  
    "width": 740,
    "height": 520,
    "background": "white",
  
    "projection": {
      "type": "mercator",
      "center": [134.5, -27.5],
      "scale": 670
    },
  
    "params": [
      {
        "name": "selectedState",
        "value": "All",
        "bind": {
          "input": "select",
          "name": "Filter by state: ",
          "options": [
            "All",
            "NSW",
            "VIC",
            "QLD",
            "SA",
            "WA",
            "TAS",
            "NT",
            "ACT"
          ],
          "labels": [
            "All states",
            "New South Wales",
            "Victoria",
            "Queensland",
            "South Australia",
            "Western Australia",
            "Tasmania",
            "Northern Territory",
            "Australian Capital Territory"
          ]
        }
      }
    ],
  
    "layer": [
      {
        "description": "Australian state boundaries",
  
        "data": {
          "url": "data/australian_states.geojson",
          "format": {
            "type": "json",
            "property": "features"
          }
        },
  
        "mark": {
          "type": "geoshape",
          "fill": "#eef1eb",
          "stroke": "#87958b",
          "strokeWidth": 0.8
        }
      },
  
      {
        "description": "National park locations",
  
        "data": {
          "url": "data/national_park_locations.csv",
          "format": {
            "type": "csv"
          }
        },
  
        "transform": [
          {
            "filter": "selectedState === 'All' || datum.state_code === selectedState"
          }
        ],
  
        "mark": {
          "type": "circle",
          "filled": true,
          "size": 24,
          "color": "#13764e",
          "opacity": 0.65,
          "stroke": "#0a4d31",
          "strokeWidth": 0.15
        },
  
        "encoding": {
          "longitude": {
            "field": "longitude",
            "type": "quantitative"
          },
  
          "latitude": {
            "field": "latitude",
            "type": "quantitative"
          },
  
          "tooltip": [
            {
              "field": "park",
              "type": "nominal",
              "title": "National park"
            },
            {
              "field": "state",
              "type": "nominal",
              "title": "State"
            },
            {
              "field": "park_area_ha",
              "type": "quantitative",
              "title": "CAPAD record area (ha)",
              "format": ",.0f"
            }
          ]
        }
      }
    ],
  
    "config": {
      "view": {
        "stroke": null
      }
    }
  }
  